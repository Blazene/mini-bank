NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://bank:bankpass@localhost:5432/minibank
BCRYPT_ROUNDS=12
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_EXPIRES_IN=1h
RATE_LIMIT_ENABLED=true
TRUST_PROXY=0
# Optional comma-separated exact frontend origins; empty denies cross-origin in production.
CORS_ORIGINS=
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

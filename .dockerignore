# Allowlist build inputs only. Frontend test/config inputs are needed for typecheck,
# but only compiled assets enter runtime. Secrets and host dependencies
# must never enter the build context, even if they are present locally.
**
!Dockerfile
!package.json
!package-lock.json
!src/
!src/**
src/**/__tests__/
src/**/__tests__/**
!scripts/
!scripts/make-admin.js
!scripts/start-render.sh
!db/
!db/migrations/
!db/migrations/*.sql
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/playwright.config.ts
!frontend/src/
!frontend/src/**
!frontend/e2e/
!frontend/e2e/*.ts
!frontend/public/
!frontend/public/**
# Defense in depth for private files accidentally nested in an allowed directory.
**/.env*
**/node_modules/
**/node_modules/**
**/.git/
**/.git/**

{
  "name": "mini-bank",
  "version": "1.0.0",
  "description": "Educational banking API with atomic transfers, loan review and transaction monitoring",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand --coverage",
    "test:coverage": "npm test",
    "test:docker": "node tests/docker/verify.js",
    "verify:demo": "node scripts/verify-demo.js",
    "dev:web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build",
    "test:web": "npm --prefix frontend test",
    "lint": "eslint .",
    "make-admin": "node scripts/make-admin.js",
    "migrate": "node-pg-migrate -m db/migrations --envPath .env",
    "migrate:test": "DATABASE_URL=postgres://bank:bankpass@localhost:5432/minibank_test npm run migrate -- up",
    "pretest": "npm run migrate:test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "yaml": "^2.9.1"
  }
}
